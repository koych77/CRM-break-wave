# Telegram Bot Token
BOT_TOKEN=your_bot_token_here

# Optional: username without @. The running bot also detects it automatically.
BOT_USERNAME=your_bot_username

# Admin IDs (Telegram ID супер-админов через запятую)
ADMIN_IDS=123456789

# Secret code for coach self-registration via /coach
ADMIN_SECRET=replace_with_a_long_random_secret

# Maximum accepted Telegram Mini App authorization age (seconds)
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600

# WebApp URL (заменить после деплоя)
WEBAPP_URL=https://your-app.up.railway.app

# Optional comma-separated cross-origin API clients. Leave empty for the Mini App.
CORS_ORIGINS=

# Database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///data/coach_crm.db
